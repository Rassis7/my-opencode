{
  "$schema": "https://opencode.ai/config.json",
  "tools": {
    "write": true,
    "bash": true,
    "webfetch": true,
    "skill": true
  },
  "plugin": [
    "opencode-skills",
    "opencode-vibeguard",
    "@tarquinen/opencode-dcp@latest",
    "@ramtinj95/opencode-tokenscope@latest",
    "@dietrichgebert/ponytail"
  ],
  "agent": {
    "command-router": {
      "description": "Executes custom command workflows and delegates specialized work to available subagents.",
      "mode": "subagent",
      "prompt": "You execute command workflows.\n\nRules:\n- Follow the command instructions exactly.\n- Do not invent a different workflow when the command already defines one.\n- Delegate specialized work whenever the command requests it, using available agents.\n- Keep one todo item in progress at a time and update progress clearly.\n- Keep responses concise and operational.\n- If command instructions are materially ambiguous, ask one concise question.\n\nState the current phase, selected subagent(s), and next action. End with status: done, blocked, or awaiting-input.",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "question": "allow",
        "task": "allow",
        "todowrite": "allow",
        "edit": "deny"
      }
    }
  },
  "mcp": {
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "oauth": {},
      "enabled": false
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "{env:CONTEXT7_API_KEY}"
      ],
      "enabled": false
    },
    "notion": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "environment": {
        "NOTION_TOKEN": "{env:NOTION_TOKEN}"
      },
      "enabled": false
    },
    "duckduckgo": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "mcp/duckduckgo"
      ],
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "DATABASE_URI",
        "crystaldba/postgres-mcp",
        "--access-mode=unrestricted"
      ],
      "environment": {
        "DATABASE_URI": "{env:DATABASE_URI}"
      },
      "enabled": false
    },
    "render": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "RENDER_API_KEY",
        "-v",
        "render-mcp-server-config:/config",
        "ghcr.io/render-oss/render-mcp-server"
      ],
      "environment": {
        "RENDER_API_KEY": "{env:RENDER_API_KEY}"
      },
      "enabled": false
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    },
    "external_directory": {
      "~/.config/opencode/records/tasks/**": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  }
}
